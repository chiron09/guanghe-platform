backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
# 视频素材缓存
backend/data/videos/
# 其它运行时数据
backend/data/

# ---- Python ----
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 前端 ----
frontend/node_modules/
frontend/dist/
frontend/*.png
frontend/*.timestamp-*.mjs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 本机配置 / 密钥 ----
.env
.env.*
*.key
*.pem

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
